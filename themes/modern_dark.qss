QWidget {
    background-color: #252b32;
    color: #d7dee5;
    selection-background-color: #214d5c;
    selection-color: #dfe8ec;
}

QMainWindow,
QDialog {
    background-color: #242a31;
}

QToolTip {
    background-color: #dbe4e8;
    color: #26323a;
    border: 1px solid #6fa9ba;
    padding: 6px 8px;
}

QMenuBar {
    background-color: #262d35;
    color: #d7dee5;
    border-bottom: 1px solid #2c3640;
    padding: 6px 10px 5px 10px;
}

QMenuBar::item {
    background: transparent;
    padding: 7px 11px;
    margin: 1px 2px;
    border-radius: 7px;
}

QMenuBar::item:selected {
    background-color: #24313a;
    color: #e1e8ed;
}

QMenu {
    background-color: #28313a;
    color: #d7dee5;
    border: 1px solid #34424d;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 10px;
    border-radius: 7px;
}

QMenu::item:selected {
    background-color: #224d5c;
    color: #e1e8ed;
}

QStatusBar {
    background-color: #262d35;
    color: #9fabba;
    border-top: 1px solid #2c3640;
}

QStatusBar QLabel {
    background: transparent;
}

QSplitter::handle {
    background-color: #28323b;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QLabel {
    background: transparent;
    color: #d7dee5;
}

QLabel#lh_decodes_title_label,
QLabel#rh_decodes_title_label {
    color: #9eacba;
    font-size: 9pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 0 5px 2px;
}

QLabel#lh_decodes_headings_label,
QLabel#rh_decodes_headings_label {
    background-color: #17242d;
    color: #a9bac7;
    border: 1px solid #2c4654;
    border-radius: 8px;
    padding: 1px 10px;
}

QLabel[panel="frequency"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #23313a, stop:1 #1f2830);
    color: #f0cf75;
    border: 1px solid #24424d;
    border-radius: 11px;
    padding: 7px 14px;
    font-size: 15pt;
    font-weight: 700;
    letter-spacing: 0.03em;
}

QLabel[panel="frequency"][oob="true"] {
    background-color: #7f2a24;
    border-color: #ad534a;
    color: #eadbd5;
}

QLabel[panel="clock"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a333b, stop:1 #252d35);
    color: #dbe6ec;
    border: 1px solid #2f3b45;
    border-radius: 11px;
    padding: 6px 12px;
}

QGroupBox {
    background-color: #262e36;
    border: 1px solid #303b45;
    border-radius: 12px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 8px;
    color: #a8b6c3;
    background-color: #242a31;
}

QWidget[surface="panel"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a323a, stop:1 #252d35);
    border: 1px solid #303b45;
    border-radius: 12px;
}

QWidget[surface="panel"] > QLabel,
QWidget[surface="panel"] > QCheckBox,
QWidget[surface="panel"] > QRadioButton {
    background: transparent;
}

QStackedWidget#opt_controls_stack,
QStackedWidget#opt_controls_stack QWidget {
    background: transparent;
    border: none;
}

QAbstractScrollArea,
QTextEdit,
QPlainTextEdit,
QListWidget,
QTreeWidget,
QTableView,
QTableWidget {
    background-color: #242b33;
    alternate-background-color: #2a333c;
    color: #d7dee5;
    border: 1px solid #303b45;
    border-radius: 12px;
}

QAbstractScrollArea[surface="decodes"],
DisplayText[surface="decodes"] {
    background-color: #222930;
    border: 1px solid #2c3944;
    border-radius: 12px;
}

QHeaderView::section {
    background-color: #19232b;
    color: #a9b8c6;
    border: none;
    border-right: 1px solid #303c47;
    border-bottom: 1px solid #303c47;
    padding: 6px 8px;
    font-weight: 600;
}

QAbstractItemView {
    background-color: #242b33;
    alternate-background-color: #2a333c;
    color: #d7dee5;
    border: 1px solid #303b45;
    border-radius: 8px;
    selection-background-color: #214d5c;
    selection-color: #dfe8ec;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: #252d35;
    color: #d7dee5;
    border: 1px solid #32404b;
    border-radius: 10px;
    padding: 5px 9px;
    min-height: 24px;
}

QComboBox {
    padding-right: 20px;
}

QStackedWidget#controls_stack_widget QLineEdit,
QStackedWidget#controls_stack_widget QComboBox,
QStackedWidget#controls_stack_widget QSpinBox,
QStackedWidget#controls_stack_widget QDoubleSpinBox {
    min-height: 18px;
    padding: 2px 6px;
    border-radius: 7px;
}

QComboBox#bandComboBox {
    min-width: 58px;
    min-height: 22px;
    max-height: 24px;
    padding: 2px 16px 2px 8px;
    border-radius: 9px;
}

QComboBox#bandComboBox QLineEdit {
    min-height: 18px;
    padding: 0 2px;
    border: none;
    background: transparent;
}

QComboBox#bandComboBox::drop-down {
    width: 14px;
}

QSpinBox#TxFreqSpinBox,
QSpinBox#RxFreqSpinBox,
QSpinBox#rptSpinBox {
    min-height: 22px;
    max-height: 24px;
    padding: 2px 17px 2px 6px;
    border-radius: 6px;
}

QToolButton[role="spin-stepper"],
QToolButton[role="combo-dropdown"] {
    min-width: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
    border-radius: 0;
    color: #9fd1df;
    background-color: #18222a;
    border: 0;
    border-left: 1px solid #32404b;
    font-size: 7pt;
    font-weight: 700;
}

QToolButton[role="spin-stepper"][step="up"] {
    border-top-right-radius: 6px;
    border-bottom: 1px solid #26343e;
}

QToolButton[role="spin-stepper"][step="down"] {
    border-bottom-right-radius: 6px;
}

QToolButton[role="spin-stepper"]:hover,
QToolButton[role="combo-dropdown"]:hover {
    background-color: #20303a;
}

QToolButton[role="spin-stepper"]:pressed,
QToolButton[role="combo-dropdown"]:pressed {
    background-color: #263946;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus {
    border: 1px solid #3d9ab7;
    background-color: #242d35;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border: none;
    margin: 0;
}

QComboBox::down-arrow:hover {
    border: none;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1b2630, stop:1 #141d25);
    color: #d7dee5;
    border: 1px solid #34414c;
    border-radius: 8px;
    padding: 4px 10px;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #22313b, stop:1 #18242d);
    border-color: #48606f;
}

QPushButton:pressed {
    background-color: #263642;
}

QPushButton:checked {
    background-color: #214d5c;
    border-color: #4b91a8;
}

QPushButton:disabled {
    background-color: #182027;
    color: #66727d;
    border-color: #2a333b;
}

QPushButton[role="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2d7f97, stop:1 #1d5d70);
    color: #dfe8ec;
    border: 1px solid #2f7e92;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3594ad, stop:1 #246b80);
    border-color: #4ba6bd;
}

QPushButton[role="monitor"],
QPushButton[role="tx"],
QPushButton[role="danger"] {
    font-weight: 600;
}

QPushButton[role="danger"] {
    color: #ffb5ad;
    border-color: #8c4a45;
}

QPushButton[role="danger"]:hover {
    background-color: #351d1f;
}

QPushButton[role="arrow"] {
    min-width: 28px;
    max-width: 32px;
    min-height: 28px;
    padding: 0;
    border-radius: 9px;
    font-size: 11pt;
    font-weight: 700;
    color: #9fd1df;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1b2630, stop:1 #141d25);
    border: 1px solid #34414c;
}

QPushButton[role="arrow"]:hover {
    color: #d4f4fb;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #22313b, stop:1 #18242d);
    border-color: #48606f;
}

QPushButton[role="arrow"]:pressed {
    background: #263642;
}

QPushButton[band="true"] {
    background-color: #19232b;
    border-color: #34414c;
    border-radius: 7px;
    padding: 3px 7px;
    min-width: 32px;
}

QPushButton[band="true"]:checked {
    background-color: #2c8aa4;
    color: #dfe8ec;
    border-color: #55a9bf;
}

QCheckBox,
QRadioButton {
    background: transparent;
    spacing: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator {
    border-radius: 4px;
    border: 1px solid #667787;
    background-color: #252d35;
}

QCheckBox::indicator:checked {
    background-color: #2d7f97;
    border-color: #3d9ab7;
}

QRadioButton::indicator {
    border-radius: 8px;
    border: 1px solid #667787;
    background-color: #252d35;
}

QRadioButton::indicator:checked {
    background-color: #3d9ab7;
    border: 4px solid #252d35;
    outline: 1px solid #3d9ab7;
}

QTabWidget::pane {
    background-color: #262e36;
    border: 1px solid #303b45;
    border-radius: 10px;
    top: -1px;
}

QTabWidget[workspace="true"]::pane {
    margin-top: 6px;
    padding: 6px;
}

QTabBar::tab:top,
QTabBar::tab:bottom,
QTabBar::tab:left,
QTabBar::tab:right {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2c353e, stop:1 #262e36);
    color: #a7b5c2;
    border: 1px solid #303b45;
    border-bottom: none;
    padding: 6px 12px;
    margin-right: 3px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    min-width: 84px;
    font-weight: 600;
}

QTabBar::tab:top:selected,
QTabBar::tab:bottom:selected,
QTabBar::tab:left:selected,
QTabBar::tab:right:selected {
    background-color: #151d24;
    color: #dfe8ec;
    border-color: #4a5b68;
}

QTabBar::tab:top:hover:!selected,
QTabBar::tab:bottom:hover:!selected,
QTabBar::tab:left:hover:!selected,
QTabBar::tab:right:hover:!selected {
    background-color: #202c35;
}

QPushButton[mode="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1b2630, stop:1 #141d25);
    border: 1px solid #34414c;
    border-radius: 7px;
    padding: 3px 8px;
    min-height: 18px;
    font-size: 8.5pt;
    font-weight: 600;
}

QPushButton[mode="true"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2d7f97, stop:1 #1d5d70);
    color: #dfe8ec;
    border-color: #4ba6bd;
}

QPushButton#DX_Call_Button,
QLabel#label_4 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #8e7626, stop:1 #6f5a1a);
    color: #e8d891;
    border: 1px solid #aa9131;
    border-radius: 8px;
    padding: 4px 8px;
}

QPushButton#DX_Call_Button:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #a68c2c, stop:1 #80681e);
}

QLabel#labAz {
    color: #a8b6c3;
    padding: 2px 4px;
}

QPushButton#lookupButton,
QPushButton#addButton,
QPushButton#ignoreButton,
QPushButton#genStdMsgsPushButton,
QPushButton#pbFreeText {
    font-weight: 600;
}

QPushButton#readFreq {
    min-width: 26px;
    min-height: 24px;
    border-radius: 12px;
    padding: 0 8px;
}

QWidget#controls_widget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #262e36, stop:1 #242b33);
    border-top: 1px solid #303b45;
}

QCheckBox#cbControls {
    color: #a7b5c2;
}

QSlider::groove:horizontal {
    background-color: #2d3741;
    border-radius: 3px;
    height: 6px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3d9ab7, stop:1 #2d748a);
    border: 1px solid #245f72;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::groove:vertical {
    background-color: #2d3741;
    border-radius: 3px;
    width: 6px;
}

QSlider::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3d9ab7, stop:1 #2d748a);
    border: 1px solid #245f72;
    height: 14px;
    margin: 0 -5px;
    border-radius: 7px;
}

QScrollBar:vertical {
    background: #2a323a;
    width: 12px;
    margin: 4px 2px 4px 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #52606d;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #6a7b89;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #2a323a;
    height: 12px;
    margin: 2px 4px 2px 4px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #52606d;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #6a7b89;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
